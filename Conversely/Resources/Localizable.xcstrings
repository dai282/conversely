        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose your two languages, then tap a mic to start talking."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn hai ngôn ngữ của bạn, rồi chạm vào mic để bắt đầu nói."
